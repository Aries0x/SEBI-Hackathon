# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=markettrust
POSTGRES_PASSWORD=markettrust_secret
POSTGRES_DB=markettrust
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://markettrust:markettrust_secret@localhost:5432/markettrust

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── MinIO ───────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=markettrust-uploads
MINIO_SECURE=false

# ── ChromaDB ────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ── Ollama (local LLM) ─────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ── Application ─────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# ── Optional API Keys ──────────────────────────────────────
# GOOGLE_FACT_CHECK_API_KEY=
# VIRUSTOTAL_API_KEY=
